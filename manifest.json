{
  "manifest_version": 3,
  "name": "AutoB2Y",
  "version": "0.1.3",
  "description": "在 YouTube 原生播放器上同步显示 Bilibili 弹幕 (Synchronize Bilibili Danmaku on YouTube)",
  "permissions": ["storage"],
  "host_permissions": [
    "https://api.bilibili.com/*",
    "https://www.youtube.com/*",
    "https://raw.githubusercontent.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://www.youtube.com/*"],
      "js": ["danmaku.min.js", "export_subs.js", "content_yt.js"],
      "css": ["style.css"],
      "run_at": "document_idle"
    },
    {
      "matches": ["*://www.bilibili.com/*"],
      "js": ["export_subs.js", "content_bili.js"],
      "css": ["style.css"],
      "run_at": "document_idle"
    }
  ]
}
